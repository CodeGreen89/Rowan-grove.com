{
  "platform": {
    "apiRuntime": "node:20"
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Content-Type-Options": "nosniff",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
  },
  "routes": [
    {
      "route": "/about*",
      "redirect": "/#about",
      "statusCode": 301
    },
    {
      "route": "/contact*",
      "redirect": "/#contact",
      "statusCode": 301
    },
    {
      "route": "/services-overview*",
      "redirect": "/#services",
      "statusCode": 301
    },
    {
      "route": "/wi-fi-mesh-network*",
      "redirect": "/#services",
      "statusCode": 301
    },
    {
      "route": "/new-page*",
      "redirect": "/#services",
      "statusCode": 301
    },
    {
      "route": "/office-365*",
      "redirect": "/#services",
      "statusCode": 301
    },
    {
      "route": "/microsoft-entra-id*",
      "redirect": "/#services",
      "statusCode": 301
    },
    {
      "route": "/starlink*",
      "redirect": "/#services",
      "statusCode": 301
    },
    {
      "route": "/azure*",
      "redirect": "/#consulting",
      "statusCode": 301
    },
    {
      "route": "/custom-scripting*",
      "redirect": "/#consulting",
      "statusCode": 301
    },
    {
      "route": "/voip-cloud-telephony*",
      "redirect": "/#services",
      "statusCode": 301
    },
    {
      "route": "/backups-redundancy*",
      "redirect": "/#services",
      "statusCode": 301
    },
    {
      "route": "/security-antivirus*",
      "redirect": "/#services",
      "statusCode": 301
    },
    {
      "route": "/hardware-sales-and-setup*",
      "redirect": "/#services",
      "statusCode": 301
    },
    {
      "route": "/api/contact",
      "methods": [
        "POST"
      ],
      "allowedRoles": [
        "anonymous"
      ]
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  }
}
